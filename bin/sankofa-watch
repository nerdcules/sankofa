#!/bin/sh
# sankofa-watch: the desktop notifier is `sankofa watch serve` (and `--once` is `sankofa watch
# once`) in the native binary built into bin/out. This launcher only finds it from a checkout,
# through a symlink or a copy with out/ beside it; a package puts the binary itself on PATH.
s=$0
while [ -L "$s" ]; do
  t=$(readlink "$s")
  case $t in /*) s=$t ;; *) s=$(dirname "$s")/$t ;; esac
done
d=$(cd "$(dirname "$s")" && pwd)
b=$d/out/sankofa
[ -x "$b" ] || b=$(command -v sankofa 2>/dev/null) || { echo "sankofa-watch: sankofa not found in $d/out or on PATH" >&2; exit 1; }
case ${1:-} in
  --once) exec "$b" watch once ;;
  "")     exec "$b" watch serve ;;
  *)      echo "usage: sankofa-watch [--once]" >&2; exit 2 ;;
esac
