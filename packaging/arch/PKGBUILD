# Maintainer: nerdcules
# Build:   cd packaging/arch && makepkg -si
# Local:   SANKOFA_SRC="git+file://$PWD/../..#branch=main" makepkg -si   (unreleased tree)
pkgname=sankofa
pkgver=0.14.0
pkgrel=1
pkgdesc="Handoff ledger and path leases for many AI coding sessions on one codebase"
arch=('x86_64')
url="https://github.com/nerdcules/sankofa"
license=('MIT')
depends=('sh' 'jq' 'git' 'sqlite' 'inotify-tools' 'libnotify')
# the window (sankofa-gui) draws with Skia on X11 or Wayland; absent on a server, the rest still works
optdepends=('fontconfig: the dashboard in a window (sankofa-gui)'
            'libx11: the dashboard in a window (sankofa-gui)')
makedepends=('dotnet-sdk' 'clang')
options=('!strip' '!debug')
source=("sankofa::${SANKOFA_SRC:-git+https://github.com/nerdcules/sankofa.git#tag=v$pkgver}")
sha256sums=('SKIP')

build() {
  cd sankofa
  export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
  dotnet publish daemon/sankofad -c Release -r linux-x64 -o out --nologo -v quiet
  dotnet publish daemon/sankofa-mcp -c Release -r linux-x64 -o out --nologo -v quiet
  dotnet publish daemon/sankofa-hub -c Release -r linux-x64 -o out --nologo -v quiet
  dotnet publish daemon/sankofa-tui -c Release -r linux-x64 -o out --nologo -v quiet
  # the window (0.12, Avalonia): its two native libraries go beside it, so it gets a directory of its own
  if [ -d daemon/sankofa-gui ]; then
    dotnet publish daemon/sankofa-gui -c Release -r linux-x64 -o out/gui --nologo -v quiet
  fi
}

check() {
  cd sankofa
  SANKOFA_DAEMON_BIN="$PWD/out/sankofad" sh tests/0.3/test_daemon.sh
}

package() {
  cd sankofa
  install -Dm755 out/sankofad "$pkgdir/usr/bin/sankofad"
  install -Dm755 out/sankofa-mcp "$pkgdir/usr/bin/sankofa-mcp"
  install -Dm755 out/sankofa-hub "$pkgdir/usr/bin/sankofa-hub"
  install -Dm755 out/sankofa-tui "$pkgdir/usr/bin/sankofa-tui"
  if [ -x out/gui/sankofa-gui ]; then
    install -Dm755 out/gui/sankofa-gui "$pkgdir/usr/lib/sankofa/sankofa-gui"
    install -Dm755 out/gui/libSkiaSharp.so out/gui/libHarfBuzzSharp.so -t "$pkgdir/usr/lib/sankofa"
    ln -s ../lib/sankofa/sankofa-gui "$pkgdir/usr/bin/sankofa-gui"
    sed 's|@BIN@|/usr/bin|g' packaging/linux/sankofa-gui.desktop \
      | install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/sankofa-gui.desktop"
  fi
  install -Dm755 bin/sankofa "$pkgdir/usr/bin/sankofa"
  install -Dm755 bin/sankofa-watch "$pkgdir/usr/bin/sankofa-watch"
  install -Dm755 hooks/git-pre-commit "$pkgdir/usr/share/sankofa/hooks/git-pre-commit"
  for f in hooks/claude-code/*.sh hooks/codex/pre-tool.sh; do
    install -Dm755 "$f" "$pkgdir/usr/share/sankofa/$f"
  done
  install -Dm644 hooks/codex/README.md "$pkgdir/usr/share/doc/$pkgname/codex.md"
  install -Dm755 install.sh "$pkgdir/usr/share/sankofa/install.sh"   # `sankofa setup` runs it
  for u in sankofad.service sankofa-watch.service; do
    sed 's|@BIN@|/usr/bin|g' "systemd/$u" | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/$u"
  done
  # the hub (on the always-on box): edit the address, then systemctl --user enable --now sankofa-hub
  sed 's|@BIN@|/usr/bin|g; s|@LISTEN@|http://127.0.0.1:8787/|g' systemd/sankofa-hub.service \
    | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/sankofa-hub.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 AGENTS.md "$pkgdir/usr/share/doc/$pkgname/AGENTS.md"
}
