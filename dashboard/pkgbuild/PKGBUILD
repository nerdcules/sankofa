# Builds from this checkout: dashboard/bin/install (makepkg -fsi).
pkgname=sankofa-dash
pkgver=0.8.0
pkgrel=1
pkgdesc='Who holds what, what is open, and what waits on you, across sankofa ledgers'
arch=('x86_64' 'aarch64')
url='https://github.com/nerdcules/sankofa'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
optdepends=('sankofa: writes the ledgers this shows')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/sankofa-dash "$pkgdir/usr/bin/sankofa-dash"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/sankofa-dash.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/sankofa-dash.svg"
  install -Dm644 "$startdir/sankofa-dash.desktop" "$pkgdir/usr/share/applications/sankofa-dash.desktop"
}
