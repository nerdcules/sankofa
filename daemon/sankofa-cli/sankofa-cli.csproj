<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sankofa command, one native binary on Linux, macOS and Windows. It replaced the POSIX
       shell CLI (0.14) so every platform runs the same code against the same ledger and daemon. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sankofa</AssemblyName>
    <RootNamespace>Sankofa.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sankofa.Core/Sankofa.Core.csproj" />
  </ItemGroup>
</Project>
