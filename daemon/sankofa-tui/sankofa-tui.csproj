<Project Sdk="Microsoft.NET.Sdk">
  <!-- The terminal dashboard: menus, tiled windows and dialogs in the Turbo Vision manner, on
       Terminal.Gui. A binary of its own, so sankofad (also the per-edit gate) stays small. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sankofa-tui</AssemblyName>
    <RootNamespace>Sankofa.Tui</RootNamespace>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Sankofa.Core/Sankofa.Core.csproj" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
  </ItemGroup>
</Project>
